# ── AWS Athena ──────────────────────────────────────────────────────────────
# Ruta S3 donde Athena guardará los resultados de las queries (requerido)
ATHENA_OUTPUT_BUCKET=s3://mi-bucket/athena-results/

AWS_REGION=us-east-1

# ── Glue Databases ───────────────────────────────────────────────────────────
# Deben coincidir exactamente con los nombres de las bases de datos
# creadas por los Glue Crawlers en tu cuenta de AWS.
GLUE_DB_CATALOGO=catalogo
GLUE_DB_COMUNITY=comunity
GLUE_DB_FRONTEND=frontend

# ── App ─────────────────────────────────────────────────────────────────────
APP_NAME=Analytics Service
API_V1_PREFIX=/api/v1
ATHENA_QUERY_TIMEOUT=60

# ── Credenciales AWS (solo si corres fuera de EC2 con Rol IAM) ──────────────
# Si la instancia EC2 tiene Rol IAM con acceso a Athena y S3, NO las necesitas.
# AWS_ACCESS_KEY_ID=tu-access-key
# AWS_SECRET_ACCESS_KEY=tu-secret-key
